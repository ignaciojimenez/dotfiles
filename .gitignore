# Secrets — never commit env files. assume the repo is public.
.env
.env.*
.envrc.local

# Local-only overrides
*.local

# Claude Code local settings (machine-specific perms; never commit).
# .claude/ holds no tracked file: the global context is linked straight from
# agent-context/AGENTS.md, and a CLAUDE.md here would mask this repo's AGENTS.md.
.claude/settings.local.json
