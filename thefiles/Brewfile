# Declarative package list — the portable part, installed on every profile.
# Personal-only packages (custom tap, casks, homelab/network tools) live in
# Brewfile.personal, which a work laptop never gets. See docs/work-host.md.
#
#     brew bundle --file=thefiles/Brewfile
#
# Idempotent: re-running only adds what's missing. Remove a line and
# `brew bundle cleanup --file=thefiles/Brewfile` to prune.

# ─── Current toolset (preserved from `brew leaves` snapshot) ─────────────────
brew "age"                   # modern file encryption (alternative to gpg)
brew "direnv"                # per-dir env vars (Cloudflare tokens, venv activation, etc.)
brew "gh"
brew "git-filter-repo"
brew "go"
brew "node"
brew "pyenv-virtualenv"      # works alongside pyenv (kept; mise NOT introduced)
brew "ykman"                 # YubiKey CLI

# ─── Modern CLI baseline (additions; safe — all are actively maintained) ─────
brew "ripgrep"               # `rg` — grep replacement
brew "fd"                    # fast `find` replacement
brew "bat"                   # cat with syntax highlighting
brew "eza"                   # modern `ls` replacement
brew "fzf"                   # fuzzy finder; powers Ctrl-R history search
brew "zoxide"                # `z <fragment>` smart cd
brew "starship"              # cross-shell prompt
brew "jq"                    # JSON
brew "yq"                    # YAML
brew "shellcheck"            # static analysis for the bash files in this repo
brew "tree"                  # directory listing (was a transitive dep; pin it)
brew "coreutils"             # gtimeout, gdate, etc. — also was transitive
