#!/bin/bash

# Make Python use UTF-8 encoding for output to stdin, stdout, and stderr.
export PYTHONIOENCODING='UTF-8';

# Prefer US English and use UTF-8.
export LANG='en_US.UTF-8';
export LC_ALL='en_US.UTF-8';

# Highlight section titles in manual pages. Guarded because .exports is reached
# via .profile by non-interactive logins too (`ssh host cmd`, cron, agent runs),
# where $TERM is unset — unguarded, tput writes an error to stderr on every one.
if [ -n "${TERM:-}" ] && [ "${TERM}" != 'dumb' ] && command -v tput >/dev/null 2>&1; then
    export LESS_TERMCAP_md="$(tput bold; tput setaf 3)";
fi

# Don’t clear the screen after quitting a manual page.
export MANPAGER='less -X';

# Avoid issues with `gpg` as installed via Homebrew.
# https://stackoverflow.com/a/42265848/96656
export GPG_TTY=$(tty);

# Starship config — top-level so bootstrap.sh's symlink whitelist owns it.
export STARSHIP_CONFIG="$HOME/.starship.toml"

# Third-party packages wait 20 days after release (AGENTS.md, Security): a
# compromised or broken release has time to be pulled first. pip >= 26.2
# honours it for every dependency it resolves; older pips ignore it silently.
export PIP_UPLOADED_PRIOR_TO=P20D
